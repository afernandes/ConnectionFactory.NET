<?xml version="1.0"?>
<package >
  <metadata>
    <id>ConnectionFactory.NET</id>
    <version>1.0.2</version>
    <title>Framework Connection Factory .NET</title>
    <authors>Anderson Fernandes do Nascimento</authors>
    <owners>afernandes</owners>
    <licenseUrl>https://github.com/afernandes/ConnectionFactory.NET/blob/master/LICENSE.md</licenseUrl>
    <projectUrl>http://afernandes.github.io/ConnectionFactory.NET/</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Functions similar to iBATIS and Dapper, but without XML</description>
    <releaseNotes>ExecuteScalar, QueryForObject, QueryForList, ExecuteReader, ExecuteNonQuery</releaseNotes>
    <copyright>Copyright 2017</copyright>
    <tags>connection-factory dapper ibatis orm dal micro-orm</tags>
	<dependencies>
        <group targetFramework="net48">
          <dependency id="log4net" version="3.5.0" />
        </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\ConnectionFactory.dll" target="lib\net48\" />
    <file src="bin\$configuration$\ConnectionFactory.XML" target="lib\net48\" />
  </files>
</package>
